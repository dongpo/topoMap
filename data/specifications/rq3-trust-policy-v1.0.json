    "AUTHORIZATION_MALFORMED",
    "AUTHORIZATION_DENIED",
    "AUTHORIZATION_EXPIRED",
    "AUTHORIZATION_HASH_MISMATCH",
    "PROPOSAL_ID_MISMATCH",
    "PROPOSAL_HASH_MISMATCH",
    "AUTHORIZATION_SCOPE_MISMATCH",
    "UNAUTHORIZED_TOOL",
    "PARAMETER_MISMATCH",
    "UNAUTHORIZED_MUTATION",
    "UNRESOLVED_CONSTRAINT_ESCALATION",
    "POSTCONDITION_FAILED",
    "PROVENANCE_INCOMPLETE",
    "ARTIFACT_HASH_MISMATCH",
    "REPLAY_LIMIT_EXCEEDED"
  ],
  "acceptance_cases": [
    {"case_id": "A", "name": "Canonical Positive Path", "expected_gate": "EXECUTE_VERIFY_ASSEMBLE", "expected_final_acceptance": "PASS"},
    {"case_id": "B", "name": "Missing Authorization", "expected_gate": "BLOCK_BEFORE_MUTATION", "expected_final_acceptance": "FAIL"},
    {"case_id": "C", "name": "Proposal Tampered After Authorization", "expected_gate": "BLOCK_BEFORE_MUTATION", "expected_final_acceptance": "FAIL"},
    {"case_id": "D", "name": "Authorization Scope Mismatch", "expected_gate": "BLOCK_BEFORE_MUTATION", "expected_final_acceptance": "FAIL"},
    {"case_id": "E", "name": "Unauthorized Tool Substitution", "expected_gate": "BLOCK_BEFORE_MUTATION", "expected_final_acceptance": "FAIL"},
    {"case_id": "F", "name": "Parameter Tampering", "expected_gate": "BLOCK_BEFORE_MUTATION", "expected_final_acceptance": "FAIL"},
    {"case_id": "G", "name": "Postcondition Violation", "expected_gate": "VERIFICATION_FAIL", "expected_final_acceptance": "FAIL"},
    {"case_id": "H", "name": "Incomplete Provenance", "expected_gate": "FINAL_ACCEPTANCE_FAIL", "expected_final_acceptance": "FAIL"},
    {"case_id": "I", "name": "Unauthorized Mutation Attempt", "expected_gate": "BLOCK_BEFORE_MUTATION", "expected_final_acceptance": "FAIL"},
    {"case_id": "J", "name": "Bounded Unresolved Constraint Escalation", "expected_gate": "BLOCK_BEFORE_MUTATION", "expected_final_acceptance": "FAIL"},
    {"case_id": "K", "name": "Result or Record Tampering", "expected_gate": "PROVENANCE_INTEGRITY_FAIL", "expected_final_acceptance": "FAIL"},
    {"case_id": "L", "name": "Exact Replay", "expected_gate": "EXECUTE_VERIFY_ASSEMBLE", "expected_final_acceptance": "PASS"}
  ],
  "replay_stability": {
    "must_match": ["semantic_result", "result_hash", "verification_verdict", "proposal_id", "proposal_hash", "authorization_id", "authorization_hash", "tool_sequence", "parameters"],
    "may_differ": ["execution_id", "verification_id", "audit_record_id", "execution_started_at", "execution_completed_at", "recorded_at"],
    "whole_record_byte_identity_claimed": false
  },
  "metrics": [
    {"metric": "authorization_enforcement_rate", "target": 1.0, "denominator": "seeded cases expected to block before mutation"},
    {"metric": "proposal_tamper_detection_rate", "target": 1.0, "denominator": "seeded post-authorization proposal mutations"},
    {"metric": "verification_detection_rate", "target": 1.0, "denominator": "seeded execution or result violations"},
    {"metric": "provenance_completeness_rate", "target": 1.0, "denominator": "mandatory provenance links and hash-valid artifacts"},
    {"metric": "false_acceptance_rate", "target": 0.0, "denominator": "canonical seeded negative cases"},
    {"metric": "false_rejection_rate", "target": 0.0, "denominator": "canonical positive case"},
    {"metric": "audit_reconstruction_completeness", "target": "PASS", "denominator": "proposal,evidence,authorization,execution,verification,result identities reconstructable"}
  ]
