    "authorization_hash_required": true,
    "scope_expansion_allowed": false,
    "missing_or_malformed_action": "BLOCK_BEFORE_MUTATION",
    "validity_semantics": "UTC closed-open interval: issued_at <= execution_started_at < valid_until; bounded research fixture, not production identity proof",
    "issuer_semantics": "recorded research operator or deterministic fixture identity only; no claim of external PKI",
    "maximum_execution_count": 2,
    "replay_policy": "one initial execution plus at most one exact idempotent replay under the same bounded environment identity"
  },
  "canonical_scope": {
    "datasets": [
