    "PARAMETER_INFERENCE_OR_SUBSTITUTION",
    "SCOPE_EXPANSION",
    "PROPOSAL_REGENERATION",
    "LLM_PLAN_REVISION",
    "PRODUCT_LAYER_RESOLUTION_WITHOUT_NEW_UPSTREAM_EVIDENCE",
    "PHYSICAL_PORTRAYAL_GATE_ESCALATION"
  ],
  "pre_execution_gate_order": [
    "PROPOSAL_SCHEMA_VALID",
    "PROPOSAL_ID_MATCH",
    "PROPOSAL_HASH_RECOMPUTED_AND_MATCHED",
    "AUTHORIZATION_PRESENT",
    "AUTHORIZATION_SCHEMA_VALID",
