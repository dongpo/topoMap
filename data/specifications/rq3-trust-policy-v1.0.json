    "AUTHORIZATION_DECISION_APPROVED",
    "AUTHORIZATION_TIME_VALID",
    "AUTHORIZATION_REPLAY_LIMIT_VALID",
    "AUTHORIZED_SUBJECT_MATCH",
    "AUTHORIZED_SCOPE_EXACT_OR_NARROWER",
    "TOOLS_AND_ORDER_EXACT",
    "PARAMETERS_EXACT",
    "UNRESOLVED_GUARDS_PRESERVED",
    "INPUT_HASHES_MATCH",
    "SOURCE_AND_OUTPUT_ROOTS_DISJOINT"
  ],
  "verification_categories": [
    "PROPOSAL_INTEGRITY",
    "AUTHORIZATION",
    "TOOL_INTEGRITY",
    "PARAMETER_INTEGRITY",
    "SCOPE_INTEGRITY",
    "CONSTRAINT_COMPLIANCE",
    "POSTCONDITION",
    "RESULT_INTEGRITY"
  ],
  "acceptance_function": {
    "expression": "proposal_integrity_pass AND authorization_pass AND execution_scope_pass AND verification_pass AND provenance_complete",
    "mandatory_inputs": [
      "proposal_integrity_pass",
      "authorization_pass",
      "execution_scope_pass",
      "verification_pass",
      "provenance_complete"
    ],
    "false_or_missing_result": "FAIL",
    "llm_override_allowed": false,
    "execution_success_is_not_authoritative_acceptance": true
  },
  "mandatory_provenance_artifact_types": [
    "PROPOSAL",
    "EVIDENCE",
    "AUTHORIZATION",
    "EXECUTION",
    "VERIFICATION",
    "RESULT"
  ],
  "failure_codes": [
