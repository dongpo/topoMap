{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nma.local/building-successor-production-contract-candidate-v1.0.schema.json",
  "title": "BUILD-09E1 successor Building production-contract candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "schema_version",
    "status",
    "created_on",
    "bindings",
    "production_binding",
    "official_portrayal_semantics",
    "output_profile_requirement",
    "polygonz_derived_xy_contract",
    "source_mutation_policy",
    "runtime_activation_policy",
    "production_activation_forbidden",
    "official_portrayal_activation_forbidden",
    "remaining_authoritative_evidence_gaps",
    "local_policy_required_items",
    "successor_production_contract_sha256"
  ],
  "properties": {
    "contract_version": {"const": "build-09e1-successor/1.0"},
    "schema_version": {"const": "nma.building-successor-production-contract-candidate/1.0"},
    "status": {"enum": ["production-candidate", "partial-production-candidate", "evidence-hold"]},
    "created_on": {"const": "2026-08-21"},
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["build09_contract_sha256", "build09e_evidence_closure_sha256", "build09e1_evidence_resolution_sha256"],
      "properties": {
        "build09_contract_sha256": {"const": "0b9e0cc9c98274f9efcbed451905fa21857c33f0ec9472254fa6e3b803c24a0c"},
        "build09e_evidence_closure_sha256": {"const": "bfee262f17b5bc99ff8e55f6b284917cf5507aaa80b0e3bae2454e35da4fbaed"},
        "build09e1_evidence_resolution_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "production_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "selected_layer_id", "selection_authorized"],
      "properties": {
        "outcome": {"const": "official-binding-not-published-or-not-available"},
        "selected_layer_id": {"const": null},
        "selection_authorized": {"const": false}
      }
    },
    "official_portrayal_semantics": {"type": "object"},
    "output_profile_requirement": {"type": "object"},
    "polygonz_derived_xy_contract": {"type": "object"},
    "source_mutation_policy": {"type": "object"},
    "runtime_activation_policy": {"type": "object"},
    "production_activation_forbidden": {"const": true},
    "official_portrayal_activation_forbidden": {"const": true},
    "remaining_authoritative_evidence_gaps": {"type": "array", "minItems": 1},
    "local_policy_required_items": {"type": "array", "minItems": 1},
    "successor_production_contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
