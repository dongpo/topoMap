{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/nma/schemas/agent-evidence-v1.0.schema.json",
  "title": "NMA Agent Evidence Object 1.0",
  "type": "object",
  "properties": {
    "schema": {"const": "nma.agent-evidence/1.0"},
    "evidence_id": {"type": "string", "pattern": "^evidence:sha256:[0-9a-f]{64}$"},
    "source_artifact": {
      "type": "object",
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1, "maxLength": 500},
        "version": {"type": "string", "minLength": 1, "maxLength": 500},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "required": ["artifact_id", "version", "sha256"],
      "additionalProperties": false
    },
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "provenance": {
      "type": "object",
      "properties": {
        "producer": {"type": "string", "minLength": 1, "maxLength": 500},
        "recorded_at": {"type": "string", "minLength": 1, "maxLength": 500}
      },
      "required": ["producer", "recorded_at"],
      "additionalProperties": false
    },
    "citation": {
      "type": "object",
      "properties": {
        "locator": {"type": "string", "minLength": 1, "maxLength": 500},
        "label": {"type": "string", "minLength": 1, "maxLength": 500}
      },
      "required": ["locator", "label"],
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "properties": {
        "status": {"enum": ["unreviewed", "reviewed", "validated"]},
        "reviewer": {"type": ["string", "null"], "minLength": 1, "maxLength": 500}
      },
      "required": ["status", "reviewer"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "unreviewed"}}},
          "then": {"properties": {"reviewer": {"type": "null"}}},
          "else": {"properties": {"reviewer": {"type": "string"}}}
        }
      ]
    },
    "reproducibility": {
      "type": "object",
      "properties": {
        "method": {
          "enum": ["direct-artifact", "deterministic-extraction", "deterministic-query"]
        },
        "recipe": {"type": "string", "minLength": 1, "maxLength": 500},
        "input_sha256": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "uniqueItems": true
        }
      },
      "required": ["method", "recipe", "input_sha256"],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "evidence_id",
    "source_artifact",
    "content_sha256",
    "provenance",
    "citation",
    "review",
    "reproducibility"
  ],
  "additionalProperties": false
}
