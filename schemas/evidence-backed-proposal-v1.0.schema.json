{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/nma/schemas/evidence-backed-proposal-v1.0.schema.json",
  "title": "NMA Evidence-Backed Proposal 1.0",
  "type": "object",
  "properties": {
    "schema": {"const": "nma.evidence-backed-proposal/1.0"},
    "intent_reference": {
      "type": "object",
      "properties": {
        "contract": {"const": "nma.intent-planning/1.0"},
        "sha256": {"type": "string", "pattern": "^intent:sha256:[0-9a-f]{64}$"}
      },
      "required": ["contract", "sha256"],
      "additionalProperties": false
    },
    "evidence_references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "schema": {"const": "nma.agent-evidence-reference/1.0"},
          "evidence_id": {"type": "string", "pattern": "^evidence:sha256:[0-9a-f]{64}$"},
          "purpose": {"const": "proposal"}
        },
        "required": ["schema", "evidence_id", "purpose"],
        "additionalProperties": false
      }
    },
    "presentation": {
      "type": "object",
      "properties": {
        "display_intent": {"enum": ["evidence_panel", "portrayal_preview"]},
        "feature_code": {"type": "string", "pattern": "^[0-9]{7}$"}
      },
      "required": ["display_intent", "feature_code"],
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "properties": {"boundary": {"const": "proposal-only"}},
      "required": ["boundary"],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "intent_reference",
    "evidence_references",
    "presentation",
    "metadata"
  ],
  "additionalProperties": false
}
