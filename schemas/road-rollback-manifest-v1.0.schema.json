{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nma.local/nma.road-rollback-manifest/1.0",
  "title": "NMA ROAD-04 Rollback Manifest 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "rollback_manifest_id", "execution_id", "receipt", "bundle", "rollback_root", "artifacts", "runtime_ids", "allowed_removal_operations", "preserve_paths", "status", "rollback_manifest_sha256"],
  "properties": {
    "schema": {"const": "nma.road-rollback-manifest/1.0"},
    "rollback_manifest_id": {"type": "string", "pattern": "^road-rollback-road-exec-[0-9a-f]{24}$"},
    "execution_id": {"type": "string", "pattern": "^road-exec-[0-9a-f]{24}$"},
    "receipt": {"$ref": "#/$defs/ref"},
    "bundle": {"$ref": "#/$defs/ref"},
    "rollback_root": {"const": "."},
    "artifacts": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "role"], "properties": {"path": {"enum": ["bundle.json", "derived-portrayal.json", "data/road-centreline-source.geojson", "data/road-centreline-runtime.geojson"]}, "sha256": {"$ref": "#/$defs/sha256"}, "role": {"enum": ["candidate-runtime-bundle", "derived-portrayal", "selected-native-geometry", "candidate-runtime-geometry"]}}}},
    "runtime_ids": {"type": "object", "additionalProperties": false, "required": ["source_ids", "layer_ids"], "properties": {"source_ids": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "string"}}, "layer_ids": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "string"}}}},
    "allowed_removal_operations": {"type": "array", "prefixItems": [{"const": "remove-file"}], "items": false},
    "preserve_paths": {"type": "array", "prefixItems": [{"const": "authorization.json"}, {"const": "plan.json"}, {"const": "receipt.json"}, {"const": "rollback-manifest.json"}, {"const": "consumption.json"}, {"const": "observations"}], "items": false},
    "status": {"const": "ready"},
    "rollback_manifest_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ref": {"type": "object", "additionalProperties": false, "required": ["id", "sha256"], "properties": {"id": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha256"}}}
  }
}
