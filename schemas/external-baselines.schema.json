{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/nma/schemas/external-baselines-1.0.json",
  "title": "NMA-Bench external baseline configuration",
  "type": "object",
  "required": ["systems"],
  "properties": {
    "systems": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "command", "context_mode"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "context_mode": {"enum": ["none", "document", "document_rag", "structured"]},
          "top_k": {"type": "integer", "minimum": 1},
          "repetitions": {"type": "integer", "minimum": 1, "maximum": 20},
          "timeout_seconds": {"type": "integer", "minimum": 1},
          "metadata": {
            "type": "object",
            "required": ["model", "model_version", "server", "server_version", "prompt_version"],
            "properties": {
              "model": {"type": "string"},
              "model_version": {"type": "string"},
              "server": {"type": "string"},
              "server_version": {"type": "string"},
              "prompt_version": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
