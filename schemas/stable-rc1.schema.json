{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/nma/stable-rc1.schema.json",
  "title": "NMA stable five-scene Demo RC1 manifest",
  "type": "object",
  "required": [
    "release_version",
    "status",
    "frozen_on",
    "source",
    "scene_order",
    "components",
    "verification",
    "environment",
    "artifacts",
    "resolved_risks",
    "non_blocking_release_gates",
    "blocking_defects",
    "post_freeze_policy"
  ],
  "properties": {
    "release_version": {"const": "nma-demo-v0.2-rc1"},
    "status": {"const": "stable-rc1"},
    "frozen_on": {"type": "string", "format": "date"},
    "source": {
      "type": "object",
      "required": ["repository", "branch", "frozen_baseline_commit", "release_tag"],
      "properties": {
        "repository": {"const": "dongpo/topoMap"},
        "branch": {"type": "string", "minLength": 1},
        "frozen_baseline_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "release_tag": {"const": "nma-demo-v0.2-rc1"}
      },
      "additionalProperties": true
    },
    "scene_order": {
      "type": "array",
      "prefixItems": [
        {"const": "school"},
        {"const": "fire-hydrant"},
        {"const": "police"},
        {"const": "fish-pond"},
        {"const": "post-office"}
      ],
      "items": false
    },
    "components": {"type": "object"},
    "verification": {"type": "object"},
    "environment": {"type": "object"},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "role", "sha256", "size_bytes"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": false
      }
    },
    "resolved_risks": {"type": "array"},
    "non_blocking_release_gates": {"type": "array"},
    "blocking_defects": {"type": "array", "maxItems": 0},
    "post_freeze_policy": {"type": "object"}
  },
  "additionalProperties": false
}
