{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nma.local/nma.rollback-manifest/1.0",
  "title": "NMA Rollback Manifest 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "rollback_id", "execution_id", "bundle_hash", "client_session", "timestamp", "status", "actions", "receipt_preserved", "receipt_file_sha256", "rollback_sha256"],
  "properties": {
    "schema": {"const": "nma.rollback-manifest/1.0"},
    "rollback_id": {"type": "string", "pattern": "^rollback-exec-[0-9a-f]{24}$"},
    "execution_id": {"type": "string", "pattern": "^exec-[0-9a-f]{24}$"},
    "bundle_hash": {"$ref": "#/$defs/sha256"},
    "client_session": {"type": "string", "minLength": 1, "maxLength": 160},
    "timestamp": {"type": "string", "format": "date-time"},
    "status": {"const": "rolled_back"},
    "actions": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "object", "additionalProperties": false, "required": ["action", "id"], "properties": {"action": {"enum": ["remove-layer", "remove-source", "remove-image"]}, "id": {"type": "string", "minLength": 1, "maxLength": 200}}}},
    "receipt_preserved": {"const": true},
    "receipt_file_sha256": {"$ref": "#/$defs/sha256"},
    "rollback_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
