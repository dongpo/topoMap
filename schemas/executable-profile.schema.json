{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/nma/schemas/executable-profile-1.0.json",
  "title": "NMA Executable Geospatial Profile",
  "type": "object",
  "required": ["specification_id", "version", "title", "status", "layer", "rules"],
  "properties": {
    "specification_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "status": {"type": "string", "minLength": 1},
    "license": {"type": "string"},
    "notice": {"type": "string"},
    "sources": {"type": "array", "items": {"type": "object"}},
    "layer": {
      "type": "object",
      "required": ["id", "label", "geometry_type", "crs"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "geometry_type": {"type": "string", "minLength": 1},
        "crs": {"type": "string", "minLength": 1},
        "feature_id_field": {"type": "string"},
        "feature_id_fallbacks": {"type": "array", "items": {"type": "string"}}
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["rule_id", "rule_type", "target", "severity", "constraint", "message", "repair", "evidence"],
        "properties": {
          "rule_id": {"type": "string", "minLength": 1},
          "rule_type": {"type": "string", "minLength": 1},
          "target": {"type": "string", "minLength": 1},
          "severity": {"enum": ["error", "warning", "info"]},
          "constraint": {"type": "object"},
          "message": {"type": "string", "minLength": 1},
          "repair": {
            "type": "object",
            "required": ["mode"],
            "properties": {
              "mode": {"enum": ["none", "safe", "proposal"]},
              "operation": {"type": "string"}
            }
          },
          "evidence": {
            "type": "object",
            "required": ["document", "version", "section", "uri", "excerpt"],
            "properties": {
              "document": {"type": "string", "minLength": 1},
              "version": {"type": "string", "minLength": 1},
              "section": {"type": "string", "minLength": 1},
              "page": {"type": ["integer", "null"], "minimum": 1},
              "uri": {"type": "string", "minLength": 1},
              "excerpt": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  }
}
