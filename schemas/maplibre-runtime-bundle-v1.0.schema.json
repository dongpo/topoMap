{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nma.local/nma.maplibre-runtime-bundle/1.0",
  "title": "NMA MapLibre Runtime Bundle 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "bundle_id", "execution_id", "source", "layer", "image_resources", "expected_feature_count", "portrayal_reference", "bundle_sha256"],
  "properties": {
    "schema": {"const": "nma.maplibre-runtime-bundle/1.0"},
    "bundle_id": {"type": "string", "pattern": "^bundle-exec-[0-9a-f]{24}$"},
    "execution_id": {"$ref": "#/$defs/execution"},
    "source": {"type": "object", "additionalProperties": false, "required": ["id", "type", "data"], "properties": {"id": {"type": "string", "pattern": "^nma-school-source-exec-[0-9a-f]{24}$"}, "type": {"const": "geojson"}, "data": {"type": "string", "pattern": "^/api/school-hero/executions/exec-[0-9a-f]{24}/data$"}}},
    "layer": {"type": "object", "additionalProperties": false, "required": ["id", "type", "source", "layout", "paint"], "properties": {"id": {"type": "string", "pattern": "^nma-school-layer-exec-[0-9a-f]{24}$"}, "type": {"const": "symbol"}, "source": {"type": "string", "pattern": "^nma-school-source-exec-[0-9a-f]{24}$"}, "layout": {"type": "object", "additionalProperties": false, "required": ["icon-image", "icon-size", "icon-rotate", "icon-allow-overlap", "text-field", "text-offset", "text-optional"], "properties": {"icon-image": {"type": "string"}, "icon-size": {"type": "number", "minimum": 0.5, "maximum": 3}, "icon-rotate": {"type": "number", "minimum": -180, "maximum": 180}, "icon-allow-overlap": {"const": false}, "text-field": {"type": "array", "maxItems": 2}, "text-offset": {"type": "array", "prefixItems": [{"const": 0}, {"const": 1.4}], "items": false}, "text-optional": {"const": true}}}, "paint": {"type": "object", "additionalProperties": false, "required": ["icon-color", "icon-opacity", "text-color"], "properties": {"icon-color": {"$ref": "#/$defs/color"}, "icon-opacity": {"type": "number", "minimum": 0.1, "maximum": 1}, "text-color": {"$ref": "#/$defs/color"}}}}},
    "image_resources": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "path", "sha256", "sdf"], "properties": {"id": {"type": "string", "pattern": "^nma-school-image-exec-[0-9a-f]{24}$"}, "path": {"type": "string", "pattern": "^/artifacts/runtime/school-hero/executions/exec-[0-9a-f]{24}/assets/school\\.svg$"}, "sha256": {"$ref": "#/$defs/sha256"}, "sdf": {"const": true}}}},
    "expected_feature_count": {"const": 15},
    "portrayal_reference": {"type": "object", "additionalProperties": false, "required": ["baseline_identity", "approved_operations_sha256", "asset_output"], "properties": {"baseline_identity": {"$ref": "#/$defs/baseline"}, "approved_operations_sha256": {"$ref": "#/$defs/sha256"}, "asset_output": {"const": "assets/school.svg"}}},
    "bundle_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "execution": {"type": "string", "pattern": "^exec-[0-9a-f]{24}$"}, "color": {"type": "string", "pattern": "^#[0-9a-f]{6}$"}, "baseline": {"type": "object", "additionalProperties": false, "required": ["id", "sha256"], "properties": {"id": {"type": "string", "minLength": 1, "maxLength": 160}, "sha256": {"$ref": "#/$defs/sha256"}}}}
}
