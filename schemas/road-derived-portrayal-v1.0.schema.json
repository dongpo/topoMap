{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nma.local/nma.road-derived-portrayal/1.0",
  "title": "NMA ROAD-04 Derived Portrayal 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "execution_id", "execution_plan", "authorization", "frozen_identities", "source", "geometry_provenance", "portrayal", "runtime_translation", "outputs", "governance", "artifact_id", "artifact_sha256"],
  "properties": {
    "schema": {"const": "nma.road-derived-portrayal/1.0"},
    "execution_id": {"$ref": "#/$defs/execution"},
    "execution_plan": {"$ref": "#/$defs/ref"},
    "authorization": {"$ref": "#/$defs/ref"},
    "frozen_identities": {"$ref": "https://schemas.nma.local/nma.road-execution-plan/1.0#/$defs/frozen"},
    "source": {"type": "object", "additionalProperties": false, "required": ["archive_sha256", "layer", "route_identity", "class_code", "ordered_segment_ids"], "properties": {"archive_sha256": {"$ref": "#/$defs/sha256"}, "layer": {"const": "K14_ROAD"}, "route_identity": {"const": "ROADNUM=縣126|ROADNUM1=|ROADNUM2=|ROADNAME=中山街"}, "class_code": {"const": "9420400"}, "ordered_segment_ids": {"$ref": "https://schemas.nma.local/nma.road-execution-plan/1.0#/$defs/segments"}}},
    "geometry_provenance": {"type": "array", "prefixItems": [{"$ref": "https://schemas.nma.local/nma.road-execution-plan/1.0#/$defs/geometry"}, {"$ref": "https://schemas.nma.local/nma.road-execution-plan/1.0#/$defs/geometry"}, {"$ref": "https://schemas.nma.local/nma.road-execution-plan/1.0#/$defs/geometry"}], "items": false},
    "portrayal": {"$ref": "https://schemas.nma.local/nma.road-execution-plan/1.0#/$defs/portrayal"},
    "runtime_translation": {"$ref": "https://schemas.nma.local/nma.road-execution-plan/1.0#/$defs/translation"},
    "outputs": {"type": "object", "additionalProperties": false, "required": ["source_geometry", "runtime_geometry"], "properties": {"source_geometry": {"$ref": "#/$defs/file"}, "runtime_geometry": {"$ref": "#/$defs/file"}}},
    "governance": {"type": "object", "additionalProperties": false, "required": ["source_mutation_performed", "topology_repair_performed", "roada_execution_performed", "road_edge_derivation_performed"], "properties": {"source_mutation_performed": {"const": false}, "topology_repair_performed": {"const": false}, "roada_execution_performed": {"const": false}, "road_edge_derivation_performed": {"const": false}}},
    "artifact_id": {"type": "string", "pattern": "^road-derived-[0-9a-f]{24}$"},
    "artifact_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "execution": {"type": "string", "pattern": "^road-exec-[0-9a-f]{24}$"},
    "ref": {"type": "object", "additionalProperties": false, "required": ["id", "sha256"], "properties": {"id": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "file": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "pattern": "^data/road-centreline-(source|runtime)\\.geojson$"}, "sha256": {"$ref": "#/$defs/sha256"}}}
  }
}
