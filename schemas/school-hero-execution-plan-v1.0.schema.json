{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nma.local/nma.school-hero-execution-plan/1.0",
  "title": "NMA School Hero Execution Plan 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "execution_plan_id", "execution_id", "authorization_id", "authorization_hash", "proposal_id", "proposal_revision", "proposal_payload_sha256", "profile_id", "feature_code", "geometry_role", "source_archive_sha256", "source_layers", "source_filter", "field_mapping", "transformation_steps", "expected_feature_count", "portrayal_reference", "maplibre_output_reference", "plan_sha256"],
  "properties": {
    "schema": {"const": "nma.school-hero-execution-plan/1.0"},
    "execution_plan_id": {"type": "string", "pattern": "^plan-[A-Za-z0-9._:-]+$", "maxLength": 160},
    "execution_id": {"type": "string", "pattern": "^exec-[0-9a-f]{24}$"},
    "authorization_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "authorization_hash": {"$ref": "#/$defs/sha256"},
    "proposal_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "proposal_revision": {"oneOf": [{"type": "integer", "minimum": 0}, {"type": "string", "minLength": 1, "maxLength": 80}]},
    "proposal_payload_sha256": {"$ref": "#/$defs/sha256"},
    "profile_id": {"const": "school-point"},
    "feature_code": {"const": "9920103"},
    "geometry_role": {"const": "Point"},
    "source_archive_sha256": {"$ref": "#/$defs/sha256"},
    "source_layers": {"type": "array", "prefixItems": [{"const": "J01_MARK"}, {"const": "J13_MARK"}, {"const": "J17_MARK"}, {"const": "K01_MARK"}, {"const": "K02_MARK"}, {"const": "K14_MARK"}], "items": false, "minItems": 6, "maxItems": 6},
    "source_filter": {"type": "object", "additionalProperties": false, "required": ["field", "operator", "value"], "properties": {"field": {"const": "TERRAINID"}, "operator": {"const": "equals"}, "value": {"const": "9920103"}}},
    "field_mapping": {"type": "object", "additionalProperties": false, "required": ["id", "feature_code", "label"], "properties": {"id": {"const": "MARKID"}, "feature_code": {"const": "TERRAINID"}, "label": {"const": "MARKNAME1"}}},
    "transformation_steps": {"type": "array", "prefixItems": [{"const": "extract-reviewed-components"}, {"const": "filter-terrainid-9920103"}, {"const": "reproject-epsg-4326"}, {"const": "force-xy"}, {"const": "materialize-deterministic-geojson"}], "items": false, "minItems": 5, "maxItems": 5},
    "expected_feature_count": {"const": 15},
    "portrayal_reference": {"type": "object", "additionalProperties": false, "required": ["baseline_identity", "approved_operations_sha256", "asset_output"], "properties": {"baseline_identity": {"$ref": "#/$defs/baseline"}, "approved_operations_sha256": {"$ref": "#/$defs/sha256"}, "asset_output": {"const": "assets/school.svg"}}},
    "maplibre_output_reference": {"const": "bundle.json"},
    "plan_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "baseline": {"type": "object", "additionalProperties": false, "required": ["id", "sha256"], "properties": {"id": {"type": "string", "minLength": 1, "maxLength": 160}, "sha256": {"$ref": "#/$defs/sha256"}}}
  }
}
