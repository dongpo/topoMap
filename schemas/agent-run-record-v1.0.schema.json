{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/nma/schemas/agent-run-record-v1.0.schema.json",
  "title": "NMA Agent Run Record 1.0",
  "type": "object",
  "properties": {
    "schema": {"const": "nma.agent-run-record/1.0"},
    "run_id": {
      "type": "string",
      "pattern": "^agent-run:sha256:[0-9a-f]{64}$"
    },
    "request_identity": {
      "type": "string",
      "pattern": "^request:sha256:[0-9a-f]{64}$"
    },
    "intent_reference": {
      "type": "object",
      "properties": {
        "contract": {"const": "nma.intent-planning/1.0"},
        "sha256": {"type": "string", "pattern": "^intent:sha256:[0-9a-f]{64}$"}
      },
      "required": ["contract", "sha256"],
      "additionalProperties": false
    },
    "evidence_references": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "properties": {
          "schema": {"const": "nma.agent-evidence-reference/1.0"},
          "evidence_id": {
            "type": "string",
            "pattern": "^evidence:sha256:[0-9a-f]{64}$"
          },
          "purpose": {"const": "proposal"}
        },
        "required": ["schema", "evidence_id", "purpose"],
        "additionalProperties": false
      }
    },
    "proposal_identity": {
      "type": "string",
      "pattern": "^proposal:sha256:[0-9a-f]{64}$"
    },
    "evaluation_reference": {
      "type": "string",
      "pattern": "^evaluation:sha256:[0-9a-f]{64}$"
    },
    "decision_record_reference": {
      "type": "string",
      "pattern": "^decision-record:sha256:[0-9a-f]{64}$"
    },
    "timestamps": {
      "type": "object",
      "properties": {
        "started_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "completed_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        }
      },
      "required": ["started_at", "completed_at"],
      "additionalProperties": false
    },
    "versions": {
      "type": "object",
      "properties": {
        "production_runtime": {"const": "nma-public-evidence-runtime/v0.2"},
        "intent_planning": {"const": "nma.intent-planning/1.0"},
        "evidence_object": {"const": "nma.agent-evidence/1.0"},
        "evidence_reference": {"const": "nma.agent-evidence-reference/1.0"},
        "proposal": {"const": "nma.evidence-backed-proposal/1.0"},
        "evaluation": {"const": "nma.agent-evaluation/1.0"},
        "decision_record": {"const": "nma.agent-decision-record/1.0"},
        "run_record": {"const": "nma.agent-run-record/1.0"}
      },
      "required": [
        "production_runtime",
        "intent_planning",
        "evidence_object",
        "evidence_reference",
        "proposal",
        "evaluation",
        "decision_record",
        "run_record"
      ],
      "additionalProperties": false
    },
    "reproducibility": {
      "type": "object",
      "properties": {
        "method": {"const": "deterministic-reference-replay"},
        "canonicalization": {"const": "json-sort-keys-utf8-sha256"},
        "hidden_state": {"const": "not-required"},
        "execution_access": {"const": "not-required"}
      },
      "required": ["method", "canonicalization", "hidden_state", "execution_access"],
      "additionalProperties": false
    },
    "completion": {
      "type": "object",
      "properties": {
        "status": {"const": "complete"},
        "chain_verification": {"const": "verified"}
      },
      "required": ["status", "chain_verification"],
      "additionalProperties": false
    },
    "boundary": {"const": "traceability-audit-replay-only"},
    "provenance": {
      "type": "object",
      "properties": {
        "recorded_by": {"type": "string", "minLength": 1, "maxLength": 500},
        "recorded_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        }
      },
      "required": ["recorded_by", "recorded_at"],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "run_id",
    "request_identity",
    "intent_reference",
    "evidence_references",
    "proposal_identity",
    "evaluation_reference",
    "decision_record_reference",
    "timestamps",
    "versions",
    "reproducibility",
    "completion",
    "boundary",
    "provenance"
  ],
  "additionalProperties": false
}
