{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.national-map-agent.org/road-authorization-consumption-fixture-v1.0.schema.json",
  "title": "ROAD-05A Authorization Consumption Fixture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "contract_version",
    "consumption_schema",
    "inputs",
    "canonical_serialization",
    "hashing",
    "expected_idempotency_key_sha256",
    "expected_consumption_file_sha256",
    "fixture_sha256"
  ],
  "properties": {
    "schema": {"const": "nma.road-authorization-consumption-fixture/1.0"},
    "contract_version": {"const": "road-05a-authorization-consumption/1.0"},
    "consumption_schema": {"const": "nma.road-authorization-consumption/1.0"},
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorization_id",
        "authorization_sha256",
        "execution_id",
        "idempotency_key",
        "receipt_id",
        "receipt_sha256"
      ],
      "properties": {
        "authorization_id": {"const": "road-03-authorization-f68220ecef989e589dd6e28c"},
        "authorization_sha256": {"$ref": "#/$defs/sha256"},
        "execution_id": {"const": "road-exec-33766f336d9cc18eb2ac159e"},
        "idempotency_key": {"const": "road04-controlled-execution-v1"},
        "receipt_id": {"const": "road-receipt-road-exec-33766f336d9cc18eb2ac159e"},
        "receipt_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "canonical_serialization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["idempotency_key", "consumption_record"],
      "properties": {
        "idempotency_key": {
          "const": "exact UTF-8 bytes; no Unicode normalization or line terminator"
        },
        "consumption_record": {
          "const": "UTF-8 JSON; keys sorted lexicographically; separators ',' and ':'; ensure_ascii=false; one trailing LF"
        }
      }
    },
    "hashing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "idempotency_input", "consumption_input"],
      "properties": {
        "algorithm": {"const": "SHA-256"},
        "idempotency_input": {"const": "inputs.idempotency_key exact UTF-8 bytes"},
        "consumption_input": {"const": "canonical persisted consumption_record bytes"}
      }
    },
    "expected_idempotency_key_sha256": {
      "const": "d4645499a8a897194ed49d7cd19edb6acd96bda5db0611fd82a701a875f343cb"
    },
    "expected_consumption_file_sha256": {"$ref": "#/$defs/sha256"},
    "fixture_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
